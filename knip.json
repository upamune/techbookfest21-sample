{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "pages/**/*.{ts,tsx}",
    "routes/**/*.ts",
    "void.config.ts",
    "scripts/*.{mjs,ts}",
    "tests/**/*.ts",
    "db/schema.ts"
  ],
  "project": ["**/*.{ts,tsx,mjs,css}", "!node_modules/**", "!.void/**", "!dist/**", "!.tools/**"],
  "ignoreDependencies": ["oxc-transform-react"]
}
