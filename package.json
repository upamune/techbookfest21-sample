{
  "name": "pocket",
  "version": "0.3.0",
  "private": true,
  "description": "Monorepo of personal apps for people and AI agents, built on Void",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "vp build .",
    "preview": "vp preview --host 127.0.0.1",
    "postinstall": "void prepare",
    "check": "void prepare && vp check",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "void prepare && tsc --noEmit",
    "test": "vp test",
    "test:e2e": "playwright test",
    "test:integration": "playwright test --project=api",
    "db:generate": "void db generate",
    "db:migrate": "void db migrate",
    "ci": "npm run check && npm run typecheck && npm test && npm run quality && npm run build && npm run test:e2e",
    "tools:setup": "node scripts/setup-quality-tools.mjs",
    "quality:complexity": "node scripts/run-quality-tool.mjs cccc src pages routes db apps packages --config cccc.toml",
    "quality:similarity": "node scripts/run-quality-tool.mjs similarity-ts src pages routes db apps packages --exclude packages/ui/src/primitives --exclude \"*.test.ts\" --exclude node_modules --threshold 0.9 --min-lines 8 --fail-on-duplicates",
    "quality:unused": "knip",
    "quality": "npm run quality:unused && npm run quality:complexity && npm run quality:similarity",
    "ci:headless": "npm run check && npm run typecheck && npm test && npm run quality && npm run build && npm run test:integration",
    "pocket": "node scripts/pocket.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.18",
    "@better-auth/mcp": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pocket/ask-ai": "*",
    "@pocket/forum": "*",
    "@pocket/things": "*",
    "@pocket/tools": "*",
    "@pocket/ui": "*",
    "better-auth": "1.7.18",
    "better-call": "1.4.5",
    "drizzle-orm": "0.45.4",
    "hono": "^4.11.9",
    "jose": "6.2.15",
    "lucide-react": "1.69.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@void/react": "1.6.2",
    "knip": "6.44.1",
    "miniflare": "5.20261101.0-beta",
    "oxc-transform-react": "^0.152.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.4.0",
    "vite-plus": "^1.4.0",
    "void": "1.6.2"
  },
  "overrides": {
    "vite": "$vite"
  },
  "engines": {
    "node": "^24.22.0 || >=26.12.0"
  },
  "packageManager": "npm@11.9.0"
}
